{
  "name": "sahayak",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @sahayak/api dev",
    "dev:web": "pnpm --filter @sahayak/web dev",
    "db:up": "docker compose up -d postgres redis",
    "db:migrate": "pnpm --filter @sahayak/db migrate",
    "db:seed": "pnpm --filter @sahayak/db seed",
    "demo:seed": "pnpm --filter @sahayak/db seed:showcase",
    "demo:reset": "pnpm exec tsx packages/db/src/seed-showcase.ts --reset",
    "db:reset": "pnpm --filter @sahayak/db reset",
    "eval": "pnpm --filter @sahayak/agents eval",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "e2e": "node scripts/e2e-isolated.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "check:model": "pnpm --filter @sahayak/agents check:model"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.48.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9.12.0",
    "pg": "^8.13.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0"
  },
  "type": "module"
}
