# Copy to .env. Never commit real keys.
DATABASE_URL=postgres://sahayak_app:sahayak_app@127.0.0.1:55450/sahayak
ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55450/sahayak
REDIS_URL=redis://127.0.0.1:56379
JWT_SECRET=change-me-in-real-deployments
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# LLM (NVIDIA hosted, OpenAI-compatible). Leave key empty to run in scripted/offline mode.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=nemotron-3-ultra-550b-a55b
LLM_TIMEOUT_MS=8000
