# Copy to .env. Never commit real keys.
DATABASE_URL=postgres://sahayak_app:sahayak_app@127.0.0.1:55450/sahayak
ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55450/sahayak
REDIS_URL=redis://127.0.0.1:56379
JWT_SECRET=change-me-in-real-deployments
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Sahayak's model service, independent of AI-Agent-Platform.
# Choose nemotron, together, or offline. A missing selected provider key uses scripted mode.
LLM_PROVIDER=nemotron
# NVIDIA (legacy/default provider)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_TIMEOUT_MS=8000
# To use Together, set LLM_PROVIDER=together and add your Together key below.
# NVIDIA's LLM_API_KEY, LLM_MODEL and LLM_BASE_URL are never used for Together.
TOGETHER_API_KEY=
TOGETHER_MODEL=openai/gpt-oss-120b
TOGETHER_REASONING_EFFORT=low

# Optional AI-Agent-Platform authoring service. Keep the shared key in .env only.
# When configured, custom-agent drafts come from the platform; Sahayak still validates and runs them.
# AGENT_PLATFORM_URL=http://127.0.0.1:8000
# AGENT_PLATFORM_KEY=

# Real WhatsApp (vendor-neutral bridge). Leave unset to use the simulator.
# WHATSAPP_PROVIDER=generic
# WHATSAPP_WEBHOOK_SECRET=
# WHATSAPP_SEND_URL=
# WHATSAPP_SEND_TOKEN=

# Clinic signup (off unless set). Anyone with the code can create a clinic, so keep it private.
# SIGNUP_INVITE_CODE=
# Outbound webhooks must be public https URLs. These two are for local testing only:
# WEBHOOKS_ALLOW_HTTP=true
# WEBHOOKS_ALLOW_PRIVATE=true

# Public addresses used inside documents sent to patients (certificate/prescription links and QR verification)
# PUBLIC_API_URL=https://api.example.com
# PUBLIC_WEB_URL=https://app.example.com

# Delegate live channels to AI-Agent-Platform; disables direct WhatsApp/voice providers.
# Platform channel execution is pending integration; simulators remain available.
LIVE_CHANNEL_OWNER=platform
